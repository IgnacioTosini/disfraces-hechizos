# PostgreSQL local: estos valores deben coincidir con DATABASE_URL.
DB_USER=postgres
DB_PASSWORD=change-me-local
DB_NAME=disfracesHechizos
DATABASE_URL=postgresql://postgres:change-me-local@localhost:5433/disfracesHechizos?schema=public

# Elegí una contraseña antes de habilitar el administrador.
ADMIN_PASSWORD=
# Opcional: secreto independiente para firmar sesiones.
ADMIN_SESSION_SECRET=

# WhatsApp del local en formato internacional, sin espacios ni signos.
NEXT_PUBLIC_WHATSAPP_NUMBER=5492235777798

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=Disfraces Hechizos

# URL pública real, con https://. Configurar también en Vercel.
SITE_URL=
